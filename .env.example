# ─── Server (optional local dev) ──────────────────────────────────────────────
# Only needed if running the local Express dev server (port 3001)

ANTHROPIC_API_KEY=sk-ant-your-key-here
PORT=3001
NODE_ENV=development

# Path to your local data folder (OneDrive/Google Drive/local)
# Only needed for local CSV processing via Claude Skills
CRM_DATA_PATH=/path/to/your/CRM-data-folder
