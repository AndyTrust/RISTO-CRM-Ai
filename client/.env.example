# ─── App Name ─────────────────────────────────────────────────────────────────
# The name of your restaurant — shown in the sidebar and loading screen
VITE_APP_NAME=Il Tuo Ristorante

# ─── Supabase ──────────────────────────────────────────────────────────────────
# Create a free project at https://supabase.com and copy these values from:
# Project Settings → API

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# ─── Optional: Anthropic Claude AI (for Chat module) ──────────────────────────
# Get your key at https://console.anthropic.com
# Add this as a Vercel/server environment variable (NOT in client .env)
# ANTHROPIC_API_KEY=your-anthropic-key-here
